# CoDoc 同写 · 基础镜像（工具链 + 依赖，极少变动）
# 仅包含：系统包（nginx/supervisor）+ 前后端 node_modules
# 业务源码与前端构建不在此处，放到应用镜像层
# 只有改了 package.json（增删依赖）才需要重建本镜像
FROM node:22-alpine

ENV PORT=1234 \
    HOST=0.0.0.0 \
    TZ=Asia/Shanghai

# nginx 负责静态资源与反向代理，supervisor 管理多进程
RUN apk add --no-cache nginx supervisor

WORKDIR /app

# ---- 后端依赖（缓存层） ----
COPY server/package.json server/package-lock.json ./server/
RUN cd /app/server && npm ci --include=dev --no-audit --no-fund

# ---- 前端依赖（缓存层） ----
COPY web/package.json web/package-lock.json ./web/
RUN cd /app/web && npm ci --include=dev --no-audit --no-fund

# 注意：此处不 COPY 业务源码、不 build。
# node_modules 保留在镜像中，供应用层（FROM 本镜像）直接复用。
CMD ["sh", "-c", "echo 'codoc base image ready'"]
