# CoDoc 智能助手 —— Hermes API Server 接入配置（复制为 .env 后填写）

# 远端 Hermes 的 OpenAI 兼容 API 地址（API Server 网关适配器，默认监听 8642）。
# 本地（WSL / 与 hermes 同机）: http://127.0.0.1:8642/v1
# 云端 Hermes（你有公网可达实例）: https://<你的域名或IP>:8642/v1
HERMES_API_URL=http://127.0.0.1:8642/v1

# 必须与 Hermes 侧的 API_SERVER_KEY 完全一致（Bearer 鉴权）。
# 在运行 hermes 的机器上设置同一个值，例如在 ~/.hermes/.env 里：
#   API_SERVER_ENABLED=true
#   API_SERVER_KEY=<在此填同一个密钥>
#   API_SERVER_HOST=127.0.0.1          # 仅本机；若 codoc 在其他机器访问则填 0.0.0.0
#   API_SERVER_PORT=8642
# 改完后用 `hermes gateway restart`（或重新 `hermes gateway run`）使配置生效。
HERMES_API_KEY=replace_me_with_your_hermes_api_server_key

# 可选：会话记忆隔离前缀（默认 codoc）。按“codoc:<docId>”给每个文档独立上下文，多轮对话不散。
# 想改成全局共享记忆可留空。
HERMES_SESSION_KEY=codoc