# ================= 依赖 / 构建产物 =================
node_modules/
dist/
**/dist/
*.tsbuildinfo

# ================= 发布产物 / 部署 =================
deploy/release/
*.tar.gz

# ================= 运行数据（容器/本地运行时生成，非源码）=================
server/data/

# ================= 环境变量（含密钥，不要提交）=================
.env
!.env.example
**/.env
!**/.env.example

# ================= 日志 / 运行输出 =================
*.log
npm-debug.log*
tsc-out.txt
result.txt

# ================= 临时 / 调试脚本 =================
_tmp/
.workbuddy/
prototype/
node_modules/.cache/
*_probe.mjs
*_smoke*.mjs
verify.mjs
_ls.txt

# ================= 数据库备份（本地磁盘保留，勿入版本库）=================
server/data_backup_*/

# ================= Vite 配置临时快照 =================
*.timestamp-*.mjs